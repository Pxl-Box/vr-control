    def do_fix(self, key, btn):
        if key == "create_hotspot":
            self.create_hotspot()
            return
        if key == "allow_libraries":
            for lib in wivrn_hidden_libraries():
                run(["flatpak", "override", "--user", f"--filesystem={lib}:ro", WIVRN_APP])
            if self.wivrn.running():
                self.toast("Done. Restart the WiVRn server (switch it off and on) for the "
                           "games to appear in the headset.")
            self.refresh_checks()
            return
        cmds = {
            "add_flathub": ["flatpak", "remote-add", "--user", "--if-not-exists", "flathub",
                            "https://dl.flathub.org/repo/flathub.flatpakrepo"],
            "install_wivrn": ["flatpak", "install", "-y", "--noninteractive", "--user",
                              "flathub", WIVRN_APP],
        }
        btn.set_sensitive(False)
        btn.set_label("Working… (this can take a few minutes)")

        def work():
            if key == "install_wivrn" and "flathub" not in run(
                    ["flatpak", "remotes", "--user", "--columns=name"])[1].split():
                run(cmds["add_flathub"], timeout=120)
            rc, out = run(cmds[key], timeout=1800)
            if rc != 0:
                GLib.idle_add(self.toast, f"That didn't work:\n{out[-800:]}")
            GLib.idle_add(self.refresh_checks)
        self.bg(work)

    def create_hotspot(self):
        dev = wifi_device()
        if not dev:
            self.toast("No Wi-Fi adapter found.")
            return
        dlg = HotspotDialog(self, wifi_caps(dev)[1])
        while dlg.run() == Gtk.ResponseType.OK:
            ssid, pw, band = dlg.ssid.get_text().strip(), dlg.pw.get_text(), dlg.band.get_active_id()
            if not ssid or len(pw) < 8 or len(pw) > 63:
                dlg.err.set_text("Enter a name and a password of 8–63 characters.")
                continue
            rc, out = run(["nmcli", "con", "add", "type", "wifi", "ifname", dev, "con-name", ssid,
                           "autoconnect", "no", "ssid", ssid, "802-11-wireless.mode", "ap",
                           "802-11-wireless.band", band, "ipv4.method", "shared",
                           "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.proto", "rsn",
                           "wifi-sec.pairwise", "ccmp", "wifi-sec.group", "ccmp",
                           "wifi-sec.psk", pw], timeout=20)
            if rc != 0:
                dlg.err.set_text(f"Couldn't create it: {out}")
                continue
            self.settings["hotspot"] = ssid
            save_settings(self.settings)
            self.resolve_network()
            break
        dlg.destroy()
        self.refresh_checks()

    # ------------------------------------------------------------ actions
    def safe_call(self, method, args=None, sig=None):
        try:
            return self.wivrn.call(method, args, sig)
        except GLib.Error as e:
            self.toast(f"WiVRn: {e.message}")
            return None

    def toast(self, msg):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                buttons=Gtk.ButtonsType.OK, text=msg)
        dlg.run()
        dlg.destroy()
        return False

    def bg(self, fn):
        threading.Thread(target=fn, daemon=True).start()

    def set_hotspot(self, on):
        self.pending["hot"] = on
        if not self.hotspot:
            if on:
                GLib.idle_add(self.toast, "No hotspot set up yet – see the Setup tab.")
        elif on:
            run(["nmcli", "radio", "wifi", "on"])
            rc, out = run(["nmcli", "con", "up", self.hotspot], timeout=30)
            if rc != 0:
                GLib.idle_add(self.toast, f"Couldn't start the hotspot:\n{out}")
        else:
            run(["nmcli", "con", "down", self.hotspot], timeout=15)
        self.pending.pop("hot", None)

    def set_wivrn(self, on):
        self.pending["wv"] = on
        if on and not self.wivrn.running():
            if not wivrn_installed():
                GLib.idle_add(self.toast, "WiVRn isn't installed yet – see the Setup tab.")
            else:
                WiVRn.start()
                for _ in range(40):
                    if self.wivrn.running():
                        break
                    time.sleep(0.25)
        elif not on and self.wivrn.running():
            try:
                self.wivrn.call("Quit")
            except GLib.Error:
                pass
            for _ in range(40):
                if not self.wivrn.running():
                    break
                time.sleep(0.25)
        self.pending.pop("wv", None)

    def on_hotspot(self, sw, _p):
        if not self.busy:
            on = sw.get_active()
            self.pending["hot"] = on
            self.bg(lambda: self.set_hotspot(on))

    def on_wivrn(self, sw, _p):
        if not self.busy:
            on = sw.get_active()
            self.pending["wv"] = on
            self.bg(lambda: self.set_wivrn(on))

    def on_start_all(self, *_):
        self.pending.update(hot=True, wv=True)
        self.bg(lambda: (self.set_hotspot(True), self.set_wivrn(True)))

    def on_stop_all(self, *_):
        self.pending.update(hot=False, wv=False)
        self.bg(lambda: (self.set_wivrn(False), self.set_hotspot(False)))

    def on_pair(self, *_):
        if not self.wivrn.running():
            self.toast("Turn the WiVRn server on first.")
            return
        r = self.safe_call("EnablePairing", (120,), "(i)")
        if r:
            self.pair_until = time.time() + 120
            self.pin_label.set_text(r[0])

    def on_setting(self, sw, _p, key):
        self.settings[key] = sw.get_active()
        save_settings(self.settings)

    # ------------------------------------------------------------ audio
    def headset_audio(self):
        sink = next((n for n in pa_names("sinks") if "wivrn" in n), None)
        src = next((n for n in pa_names("sources") if "wivrn" in n), None)
        return sink, src

    def load_prev(self):
        try:
            with open(PREV_FILE) as f:
                return tuple(json.load(f))
        except Exception:  # noqa: BLE001
            return None

    def save_prev(self):
        if self.prev_audio is None:
            try:
                os.remove(PREV_FILE)
            except OSError:
                pass
        else:
            os.makedirs(CONF_DIR, exist_ok=True)
            with open(PREV_FILE, "w") as f:
                json.dump(list(self.prev_audio), f)

    def audio_to_headset(self, out=True, mic=True, quiet=False):
        if not have("pactl"):
            return
        sink, src = None, None
        for _ in range(20):          # the WiVRn devices appear a moment after connecting
            sink, src = self.headset_audio()
            if sink:
                break
            time.sleep(0.5)
        if not sink:
            if not quiet:
                GLib.idle_add(self.toast, "The headset audio devices only exist while the "
                              "headset is connected.")
            return
        sink = sink if out else None
        src = src if mic else None
        old_k, old_s = self.prev_audio or (None, None)
        cur_k, cur_s = pa_default("sink"), pa_default("source")
        self.prev_audio = (old_k or (cur_k if sink and "wivrn" not in cur_k else None),
                           old_s or (cur_s if src and "wivrn" not in cur_s else None))
        self.save_prev()
        n = route_audio(sink, src)
        if not quiet:
            what = " + ".join(w for w, ok in (("sound output", sink), ("microphone", src)) if ok)
            GLib.idle_add(self.toast, f"Headset now used for {what}; moved {n} stream(s).")

    def audio_restore(self):
        if not self.prev_audio or not have("pactl"):
            return
        sink, src = self.prev_audio
        self.prev_audio = None
        self.save_prev()
        names_k, names_s = pa_names("sinks"), pa_names("sources")
        route_audio(sink if sink in names_k else None, src if src in names_s else None)

    def on_audio(self, *_):
        self.bg(self.audio_to_headset)

    def on_connect_change(self, connected):
        out, mic = self.settings["auto_audio_out"], self.settings["auto_audio_mic"]
        if connected:
            if out or mic:
                self.audio_to_headset(out=out, mic=mic, quiet=True)
        else:
            self.audio_restore()       # only puts back what was switched

    # ------------------------------------------------------------ polling
    def poll_loop(self):
        tick = 0
        while not self.stop:
            d = {}
            hs, dev = self.hotspot, self.dev
            d["hot"] = hotspot_on(hs)
            if d["hot"]:
                d["hot_info"] = hotspot_info(hs)
                d["clients"] = hotspot_clients(dev) if dev else []
                if tick % 10 == 0 or "psk" not in self.__dict__:
                    self.psk = run(["nmcli", "-s", "-g", "802-11-wireless-security.psk",
                                    "con", "show", hs])[1]
            b = iface_bytes(dev) if dev else None
            now = time.time()
            if b and self.last_bytes and self.last_t:
                dt = now - self.last_t
                d["tx"] = (b[0] - self.last_bytes[0]) * 8 / dt / 1e6
                d["rx"] = (b[1] - self.last_bytes[1]) * 8 / dt / 1e6
            self.last_bytes, self.last_t = b, now
            d["wv"] = self.wivrn.running()
            d["props"] = self.wivrn.props() if d["wv"] else None
            d["gpu"] = gpu_stats()
            d["sink"] = have("pactl") and any("wivrn" in n for n in pa_names("sinks"))
            conn = bool((d["props"] or {}).get("HeadsetConnected"))
            if conn != self.was_connected:
                self.was_connected = conn
                self.bg(lambda c=conn: self.on_connect_change(c))
            GLib.idle_add(self.update, d)
            tick += 1
            time.sleep(1)

    def update(self, d):
        self.busy = True
        hot, wv, p = d["hot"], d["wv"], d["props"] or {}

        if "hot" in self.pending:
            set_state(self.hs_label, "Turning on…" if self.pending["hot"] else "Turning off…", "warn")
        elif not self.hotspot:
            self.hot_sw.set_active(False)
            set_state(self.hs_label, "Not set up – see Setup", "off")
        else:
            self.hot_sw.set_active(hot)
            set_state(self.hs_label, "On" if hot else "Off", "ok" if hot else "off")
        self.hot_sw.set_sensitive(bool(self.hotspot))
        ssid = None
        if hot:
            ssid, band, chan, addr = d["hot_info"][:4]
            self.hot_grid.set("Network", ssid or self.hotspot)
            self.hot_grid.set("Password", getattr(self, "psk", "") or "–")
            self.hot_grid.set("Band / channel",
                              f"{'5 GHz' if band == 'a' else '2.4 GHz' if band == 'bg' else band}"
                              f" / {chan if chan and chan != '0' else 'auto'}")
            self.hot_grid.set("PC address", addr.split("/")[0] if addr else "10.42.0.1")
            cl = d["clients"]
            self.hot_grid.set("Devices", f"{len(cl)} ({', '.join(cl)})" if cl else "0")
        else:
            for k in ("Network", "Password", "Band / channel", "PC address", "Devices"):
                self.hot_grid.set(k, "–")
        if "tx" in d and hot:
            self.hot_grid.set("Wi-Fi traffic", f"↑ {d['tx']:.1f} Mbit/s   ↓ {d['rx']:.1f} Mbit/s")
        else:
            self.hot_grid.set("Wi-Fi traffic", "–")

        if "wv" in self.pending:
            set_state(self.wv_label, "Starting…" if self.pending["wv"] else "Stopping…", "warn")
        else:
            self.wv_sw.set_active(wv)
            set_state(self.wv_label, "Running – waiting for headset" if wv and not
                      p.get("HeadsetConnected") else "Running" if wv else "Stopped",
                      "ok" if wv else "off")
        keys = p.get("KnownKeys") or []
        self.wv_grid.set("PC name", GLib.get_host_name() if wv else "–")
        self.wv_grid.set("Paired headsets", ", ".join(k[0] for k in keys) if keys else
                         ("none yet – pair below" if wv else "–"))
        self.wv_grid.set("Encryption", ("on" if p.get("EncryptionEnabled") else "off") if wv else "–")

        conn = bool(p.get("HeadsetConnected"))
        if conn and not self.connected_since:
            self.connected_since = time.time()
        if not conn:
            self.connected_since = None
        if conn:
            set_state(self.hs_state, "● Connected", "ok")
            self.hs_hint.set_text("Start a game from the WiVRn app's list or from Steam.")
        elif wv and hot:
            set_state(self.hs_state, "● Waiting for headset", "warn")
            self.hs_hint.set_text(f"On the headset: join the “{ssid or self.hotspot}” Wi-Fi, open "
                                  f"WiVRn, pick {GLib.get_host_name()}."
                                  + ("" if keys else " First time: press Start pairing below."))
        else:
            set_state(self.hs_state, "● Not ready", "off")
            missing = [n for n, ok in (("hotspot", hot), ("WiVRn server", wv)) if not ok]
            self.hs_hint.set_text("Turn on: " + " and ".join(missing) + " (or press Start VR).")
        g = self.hs_grid
        if conn:
            g.set("Headset", p.get("SystemName") or "Quest")
            s = int(time.time() - self.connected_since)
            g.set("Connected for", f"{s // 3600}h {s // 60 % 60:02d}m {s % 60:02d}s" if s >= 3600
                  else f"{s // 60}m {s % 60:02d}s")
            g.set("Game running", "Yes" if p.get("SessionRunning") else "No")
            rr = p.get("PreferredRefreshRate") or 0
            avail = p.get("AvailableRefreshRates") or []
            g.set("Refresh rate", (f"{rr:g} Hz" if rr else "auto") +
                  (f"  (supports {', '.join(f'{r:g}' for r in avail)})" if avail else ""))
            br = p.get("Bitrate") or 0
            g.set("Stream bitrate", f"{br / 1e6:.0f} Mbit/s" if br else "auto")
            g.set("Codecs", ", ".join(p.get("SupportedCodecs") or []) or "–")
            sp = p.get("SpeakerChannels") or 0
            g.set("Audio", (f"{sp} ch @ {p.get('SpeakerSampleRate', 0) // 1000} kHz"
                            if sp else "none") + ("  · headset output ready" if d["sink"] else ""))
            g.set("Hand tracking", "on" if p.get("HandTracking") else "off")
        else:
            for k in g.vals:
                g.set(k, "–")
        self.audio_btn.set_sensitive(conn and d["sink"])
        self.disc_btn.set_sensitive(conn)

        if p.get("PairingEnabled"):
            if p.get("Pin"):
                self.pin_label.set_text(p["Pin"])
            left = int(self.pair_until - time.time())
            self.pin_hint.set_text(f"Pairing open – {left}s left" if left > 0 else "Pairing open")
        else:
            self.pin_label.set_text("— — — — — —")
            self.pin_hint.set_text("")
        self.pair_btn.set_sensitive(wv)
        self.unpair_btn.set_sensitive(bool(p.get("PairingEnabled")))

        gp = d["gpu"]
        if gp:
            self.gpu_grid.set("GPU load", f"{gp['util']}%")
            self.gpu_grid.set("Video encoder", f"{gp['enc']}%")
            self.gpu_grid.set("GPU temp", f"{gp['temp']} °C")
            self.gpu_grid.set("VRAM", gp["mem"])
        else:
            self.gpu_grid.set("GPU load", "only shown for NVIDIA GPUs")

        self.start_all_btn.set_sensitive(not (hot and wv))
        self.stop_all_btn.set_sensitive(hot or wv)
        self.busy = False
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.vr_control.VRControl")

    def do_activate(self):
        win = self.props.active_window
        if not win:
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = VRControl(self)
        win.present()


def cli_check():
    """`vr-control --check`: print the setup checklist in a terminal."""
    for r in run_checks(load_settings()):
        print(f"[{MARK[r['status']]}] {r['title']}: {r['detail']}")
        for fx in r["fixes"]:
            if fx[0] == "cmd":
                print(f"      run: {fx[1]}")
            elif fx[0] == "link":
                print(f"      see: {fx[2]}")
            elif fx[0] == "action":
                print(f"      fix: open VR Control → Setup → “{fx[1]}”")


if __name__ == "__main__":
    import sys
    if "--check" in sys.argv:
        cli_check()
    elif "--version" in sys.argv:
        print(VERSION)
    else:
        App().run(None)
