# ---------------------------------------------------------------- setup checks
OK, BAD, WARN, INFO = "ok", "bad", "warn", "info"
MARK = {OK: "✔", BAD: "✘", WARN: "!", INFO: "i"}


def run_checks(settings):
    """Return a list of dicts: title, status, detail, and optional fix:
    ('action', label, key) | ('cmd', command) | ('link', label, url)."""
    c = []

    def add(title, status, detail, *fixes):
        c.append(dict(title=title, status=status, detail=detail, fixes=list(fixes)))

    # Flatpak + Flathub + WiVRn
    if have("flatpak"):
        add("Flatpak", OK, "Installed.")
        rc, remotes = run(["flatpak", "remotes", "--columns=name"])
        if "flathub" in remotes.split():
            add("Flathub app store", OK, "The Flathub remote is set up.")
        else:
            add("Flathub app store", BAD, "Needed to download WiVRn.",
                ("action", "Add Flathub", "add_flathub"))
    else:
        add("Flatpak", BAD, "Needed to install WiVRn.", ("cmd", pkg_cmd("flatpak")),
            ("link", "Flatpak setup guide", FLATPAK_SETUP_URL))
    where = wivrn_installed()
    if where:
        add("WiVRn streaming server", OK, f"Version {wivrn_version() or '?'} ({where} install).")
    else:
        if have("flatpak"):
            add("WiVRn streaming server", BAD, "Streams games to the headset (Flatpak from "
                "Flathub).", ("action", "Install WiVRn", "install_wivrn"),
                ("link", "About WiVRn", WIVRN_URL))
        else:
            add("WiVRn streaming server", BAD, "Install Flatpak first (above), then come back "
                "here to install WiVRn.", ("link", "About WiVRn", WIVRN_URL))

    # Network
    dev = None
    if have("nmcli"):
        add("NetworkManager", OK, "Installed.")
        dev = wifi_device()
        if dev:
            ap, five = wifi_caps(dev)
            if ap:
                add("Wi-Fi adapter", OK if five else WARN,
                    f"{dev}: hotspot supported" + (", 5 GHz." if five else
                    ", but no 5 GHz – 2.4 GHz works but is slower and laggier."))
            else:
                add("Wi-Fi adapter", BAD, f"{dev} can't act as a hotspot. Use a router instead: "
                    "PC wired to it, headset on its 5 GHz Wi-Fi (skip the hotspot).")
        else:
            add("Wi-Fi adapter", WARN, "No Wi-Fi adapter found. You can still use a router: "
                "PC wired to it, headset on its 5 GHz Wi-Fi (skip the hotspot).")
        hs = settings.get("hotspot") if settings.get("hotspot") in find_hotspots() else None
        hs = hs or next(iter(find_hotspots()), None)
        if hs:
            add("VR hotspot", OK, f"Using the “{hs}” hotspot connection.")
        elif dev and wifi_caps(dev)[0]:
            add("VR hotspot", BAD, "Create a private Wi-Fi network for the headset.",
                ("action", "Create hotspot…", "create_hotspot"))
    else:
        add("NetworkManager", BAD, "Needed for the hotspot.", ("cmd", pkg_cmd("nmcli")))

    # Discovery + firewall
    if run(["systemctl", "is-active", "avahi-daemon"])[1] == "active":
        add("Avahi (auto-discovery)", OK, "The headset will find this PC automatically.")
    else:
        add("Avahi (auto-discovery)", WARN, "Not running – the PC won't show up in the headset "
            "list (you can still type its IP).", ("cmd", pkg_cmd("avahi")))
    fw, on = firewall_status()
    if on:
        add(f"Firewall ({fw})", WARN, "Make sure WiVRn's ports are open (this can't be checked "
            "without admin rights). Run once in a terminal:", ("cmd", firewall_cmd(fw, dev)))
    else:
        add("Firewall", OK, "No active firewall blocking WiVRn.")

    # Audio, GPU, Steam
    if have("pactl"):
        add("Audio (PipeWire/PulseAudio)", OK, "Headset audio switching available.")
    else:
        add("Audio (PipeWire/PulseAudio)", WARN, "pactl missing – audio switching disabled.",
            ("cmd", pkg_cmd("pactl")))
    enc = gpu_encoder()
    add("GPU video encoder", OK if enc else BAD, enc or "No GPU render device found.")
    sk = steam_kind()
    if sk == "native":
        add("Steam", OK, "Installed. Add the launch options below to each VR game.")
    elif sk == "flatpak":
        add("Steam", WARN, "Flatpak Steam needs extra permissions for WiVRn – see the WiVRn docs "
            "(native Steam is simpler).", ("link", "WiVRn docs", WIVRN_URL))
    else:
        add("Steam", WARN, "Not found (only needed for Steam games).")
    if where:
        hidden = wivrn_hidden_libraries()
        if hidden:
            add("Games visible in the headset", BAD, "WiVRn can't see these Steam libraries, so "
                "their games won't be in the headset's game list: " + ", ".join(hidden),
                ("action", "Let WiVRn see them", "allow_libraries"))
        elif sk:
            add("Games visible in the headset", OK, "WiVRn can read all your Steam libraries.")
    opts = steam_launch_options()
    if opts:
        add("Steam launch options", INFO, "Paste into each VR game: Properties → Launch Options.",
            ("cmd", opts))

    # Headset (can't be checked from the PC)
    add("WiVRn app on the headset", INFO, "Install WiVRn on the Quest (Meta Horizon Store, or "
        f"sideload the APK). Use the same version as the PC ({wivrn_version() or 'see above'}).",
        ("link", "Headset install guide", WIVRN_HEADSET_URL))
    return c


class HotspotDialog(Gtk.Dialog):
    def __init__(self, parent, five):
        super().__init__(title="Create VR hotspot", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = self.add_button("Create", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)
        box.pack_start(label("A private Wi-Fi network from this PC, just for the headset. "
                             "Your normal internet connection is unaffected.", "dim", wrap=True),
                       False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        self.ssid = Gtk.Entry(text="vr-hotspot", hexpand=True)
        alphabet = string.ascii_letters + string.digits
        self.pw = Gtk.Entry(text="".join(secrets.choice(alphabet) for _ in range(12)))
        self.band = Gtk.ComboBoxText()
        if five:
            self.band.append("a", "5 GHz (best)")
        self.band.append("bg", "2.4 GHz")
        self.band.set_active(0)
        for i, (k, w) in enumerate((("Network name", self.ssid), ("Password", self.pw),
                                    ("Band", self.band))):
            grid.attach(label(k), 0, i, 1, 1)
            grid.attach(w, 1, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        self.err = label("", "state-bad", wrap=True)
        box.pack_start(self.err, False, False, 0)
        self.show_all()


# ---------------------------------------------------------------- window
class VRControl(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="VR Control")
        self.set_default_size(580, 760)
        self.set_icon_name("vr-control")
        self.wivrn = WiVRn()
        self.busy = False          # suppress switch feedback while we set it
        self.pending = {}          # target state for in-flight toggles
        self.last_bytes = None
        self.last_t = None
        self.connected_since = None
        self.pair_until = 0
        self.settings = load_settings()
        self.prev_audio = self.load_prev()  # (sink, source) to restore after the headset leaves
        self.was_connected = False
        self.hotspot = None
        self.dev = None
