    def refresh_checks(self):
        self.setup_summary.set_text("Checking…")

        def work():
            res = run_checks(self.settings)
            GLib.idle_add(self.show_checks, res)
        self.bg(work)

    def show_checks(self, res):
        for ch in self.checks_box.get_children():
            self.checks_box.remove(ch)
        bad = sum(r["status"] == BAD for r in res)
        warn = sum(r["status"] == WARN for r in res)
        for r in res:
            row = Gtk.Box(spacing=10, margin_top=4, margin_bottom=4)
            mark = label(MARK[r["status"]], "mark state-" + r["status"], xalign=0.5)
            mark.set_valign(Gtk.Align.START)
            row.pack_start(mark, False, False, 0)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            col.pack_start(label(r["title"], "card-title"), False, False, 0)
            col.pack_start(label(r["detail"], "dim", wrap=True), False, False, 0)
            for fx in r["fixes"]:
                col.pack_start(self.fix_widget(fx), False, False, 0)
            row.pack_start(col, True, True, 0)
            self.checks_box.pack_start(row, False, False, 0)
            self.checks_box.pack_start(Gtk.Separator(), False, False, 0)
        if bad:
            set_state(self.setup_summary, f"✘ {bad} thing{'s' if bad > 1 else ''} to fix", "bad")
        elif warn:
            set_state(self.setup_summary, f"! Ready – {warn} thing{'s' if warn > 1 else ''} to "
                      "double-check", "warn")
        else:
            set_state(self.setup_summary, "✔ Everything's ready", "ok")
        self.setup_banner.set_visible(bad > 0)
        if bad and self.first_check:
            self.stack.set_visible_child_name("setup")
        self.first_check = False
        self.checks_box.show_all()
        return False

    def fix_widget(self, fx):
        kind = fx[0]
        if kind == "action":
            b = Gtk.Button(label=fx[1], halign=Gtk.Align.START)
            b.get_style_context().add_class("suggested-action")
            b.connect("clicked", lambda btn: self.do_fix(fx[2], btn))
            return b
        if kind == "link":
            return Gtk.LinkButton(uri=fx[2], label=fx[1], halign=Gtk.Align.START)
        box = Gtk.Box(spacing=6)
        lb = label(fx[1], "mono", wrap=True, select=True)
        lb.set_hexpand(True)
        box.pack_start(lb, True, True, 0)
