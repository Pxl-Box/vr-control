def run(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout.strip() or r.stderr.strip())
    except Exception as e:  # noqa: BLE001
        return 1, str(e)


def have(cmd):
    return shutil.which(cmd) is not None


# ---------------------------------------------------------------- settings
def load_settings():
    try:
        with open(SETTINGS) as f:
            st = {**DEFAULTS, **json.load(f)}
        if "auto_audio" in st:       # older single switch -> both new switches
            st["auto_audio_out"] = st["auto_audio_mic"] = st.pop("auto_audio")
        return st
    except Exception:  # noqa: BLE001
        return dict(DEFAULTS)


def save_settings(st):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(SETTINGS, "w") as f:
        json.dump(st, f, indent=2)


# ---------------------------------------------------------------- system probes
def distro_family():
    ids = ""
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith(("ID=", "ID_LIKE=")):
                    ids += " " + line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    for fam in ("arch", "fedora", "suse", "debian", "ubuntu"):
        if fam in ids:
            return "debian" if fam == "ubuntu" else fam
    return "unknown"


PKG = {  # what to install for a missing tool, per distro family
    "flatpak": {"debian": "sudo apt install flatpak", "fedora": "sudo dnf install flatpak",
                "arch": "sudo pacman -S flatpak", "suse": "sudo zypper install flatpak"},
    "nmcli": {"debian": "sudo apt install network-manager",
              "fedora": "sudo dnf install NetworkManager",
              "arch": "sudo pacman -S networkmanager",
              "suse": "sudo zypper install NetworkManager"},
    "pactl": {"debian": "sudo apt install pipewire-pulse pulseaudio-utils",
              "fedora": "sudo dnf install pipewire-pulseaudio pulseaudio-utils",
              "arch": "sudo pacman -S pipewire-pulse libpulse",
              "suse": "sudo zypper install pipewire-pulseaudio pulseaudio-utils"},
    "avahi": {"debian": "sudo apt install avahi-daemon && sudo systemctl enable --now avahi-daemon",
              "fedora": "sudo dnf install avahi && sudo systemctl enable --now avahi-daemon",
              "arch": "sudo pacman -S avahi && sudo systemctl enable --now avahi-daemon",
              "suse": "sudo zypper install avahi && sudo systemctl enable --now avahi-daemon"},
}


def pkg_cmd(tool):
    fam = distro_family()
    return PKG[tool].get(fam) or "Install it with your distro's package manager."


def wifi_device():
    rc, out = run(["nmcli", "-t", "-f", "DEVICE,TYPE", "dev"])
    for line in out.splitlines() if rc == 0 else []:
        dev, _, typ = line.rpartition(":")
        if typ == "wifi" and not dev.startswith("p2p-"):
            return dev
    return None


def wifi_caps(dev):
    rc, out = run(["nmcli", "-t", "-f", "WIFI-PROPERTIES.AP,WIFI-PROPERTIES.5GHZ", "dev", "show", dev])
    caps = dict(l.split(":", 1) for l in out.splitlines() if ":" in l) if rc == 0 else {}
    return caps.get("WIFI-PROPERTIES.AP") == "yes", caps.get("WIFI-PROPERTIES.5GHZ") == "yes"


def find_hotspots():
    """Names of NetworkManager Wi-Fi connections in access-point (hotspot) mode."""
    rc, out = run(["nmcli", "-t", "-f", "NAME,TYPE", "con", "show"])
    names = []
    for line in out.splitlines() if rc == 0 else []:
        name, _, typ = line.rpartition(":")
        if typ == "802-11-wireless":
            name = name.replace("\\:", ":")
            if run(["nmcli", "-g", "802-11-wireless.mode", "con", "show", name])[1] == "ap":
                names.append(name)
    return names


def wivrn_installed():
    """'user', 'system' or None."""
    if not have("flatpak"):
        return None
    if run(["flatpak", "info", "--user", WIVRN_APP])[0] == 0:
        return "user"
    if run(["flatpak", "info", "--system", WIVRN_APP])[0] == 0:
        return "system"
    return None


def wivrn_version():
    rc, out = run(["flatpak", "info", WIVRN_APP])
    for line in out.splitlines() if rc == 0 else []:
        if line.strip().startswith("Version:"):
            return line.split(":", 1)[1].strip()
    return None


def wivrn_manifest():
    """Path of WiVRn's OpenXR runtime manifest that survives Flatpak updates."""
    rc, loc = run(["flatpak", "info", "--show-location", WIVRN_APP])
    if rc != 0 or "/" + WIVRN_APP + "/" not in loc:
        return None
    base = loc.split("/" + WIVRN_APP + "/")[0] + "/" + WIVRN_APP
    return base + "/current/active/files/share/openxr/1/openxr_wivrn.json"


def steam_kind():
    if have("steam"):
        return "native"
    if have("flatpak") and run(["flatpak", "info", "com.valvesoftware.Steam"])[0] == 0:
        return "flatpak"
    return None


def steam_libraries():
    """Steam library folders listed in libraryfolders.vdf."""
    import re
    paths = []
    for base in ("~/.steam/steam", "~/.local/share/Steam",
                 "~/.var/app/com.valvesoftware.Steam/data/Steam"):
        f = os.path.expanduser(base + "/steamapps/libraryfolders.vdf")
        try:
            with open(f) as fh:
                paths += re.findall(r'"path"\s+"([^"]+)"', fh.read())
        except OSError:
            pass
    return list(dict.fromkeys(os.path.realpath(p) for p in paths))


def wivrn_hidden_libraries():
    """Steam libraries the WiVRn Flatpak can't read, so their games don't show up in the
    headset's game list (it only gets ~/.steam and ~/.local/share/Steam by default)."""
    home = os.path.realpath(os.path.expanduser("~"))
    allowed = [os.path.join(home, ".steam"), os.path.join(home, ".local/share/Steam"),
               os.path.join(home, ".var/app/com.valvesoftware.Steam")]
    rc, out = run(["flatpak", "override", "--user", "--show", WIVRN_APP])
    for line in out.splitlines():
        if line.startswith("filesystems="):
            allowed += [os.path.realpath(os.path.expanduser(x.split(":")[0]))
                        for x in line.split("=", 1)[1].split(";") if x.startswith(("/", "~"))]
    rc, out = run(["flatpak", "info", "--show-permissions", WIVRN_APP])
    for line in out.splitlines():
        if line.startswith("filesystems="):
            for x in line.split("=", 1)[1].split(";"):
                x = x.split(":")[0]
                if x in ("host", "home"):   # host-os / host-etc are system dirs only
                    allowed.append(home if x == "home" else "/")
                elif x.startswith(("/", "~")):
                    allowed.append(os.path.realpath(os.path.expanduser(x)))
    hidden = []
    for lib in steam_libraries():
        if not any(lib == a or lib.startswith(a.rstrip("/") + "/") for a in allowed):
            hidden.append(lib)
    return hidden


def steam_launch_options():
    m = wivrn_manifest()
    if not m:
        return None
    # OXR_PARALLEL_VIEWS=0: fixes Beat Saber pausing itself; harmless for other games.
    return (f"OXR_PARALLEL_VIEWS=0 XR_RUNTIME_JSON={m} "
            "PRESSURE_VESSEL_FILESYSTEMS_RW=$XDG_RUNTIME_DIR/wivrn/comp_ipc %command%")


def firewall_status():
    """('ufw'|'firewalld'|None, enabled?)"""
    try:
        with open("/etc/ufw/ufw.conf") as f:
            if "ENABLED=yes" in f.read():
                return "ufw", True
    except OSError:
        pass
    if run(["systemctl", "is-active", "firewalld"])[1] == "active":
        return "firewalld", True
    return None, False


def firewall_cmd(kind, dev):
    if kind == "ufw":
        return ("sudo ufw allow 9757/tcp && sudo ufw allow 9757/udp && sudo ufw allow 5353/udp"
                + (f" && sudo ufw allow in on {dev}" if dev else ""))
    if kind == "firewalld":
        return ("sudo firewall-cmd --permanent --add-port=9757/tcp --add-port=9757/udp "
                "--add-service=mdns && sudo firewall-cmd --reload")
    return ""


def gpu_encoder():
    if have("nvidia-smi") and run(["nvidia-smi", "-L"])[0] == 0:
        return "NVIDIA (NVENC)"
    if any(n.startswith("renderD") for n in os.listdir("/dev/dri")) if os.path.isdir("/dev/dri") else False:
        return "AMD / Intel (VA-API)"
    return None


# ---------------------------------------------------------------- live data
def hotspot_on(con):
    rc, out = run(["nmcli", "-t", "-f", "NAME", "con", "show", "--active"])
    return bool(con) and rc == 0 and con in out.splitlines()


def hotspot_info(con):
    rc, out = run(["nmcli", "-t", "-g", "802-11-wireless.ssid,802-11-wireless.band,"
                   "802-11-wireless.channel,IP4.ADDRESS", "con", "show", con])
    lines = out.splitlines() if rc == 0 else []
    return lines + [""] * (4 - len(lines))


def hotspot_clients(dev):
    rc, out = run(["ip", "-j", "neigh", "show", "dev", dev])
    try:
        return [n["dst"] for n in json.loads(out or "[]")
                if n.get("state") and not set(n["state"]) & {"FAILED", "INCOMPLETE"}
                and "." in n.get("dst", "")]
    except Exception:  # noqa: BLE001
        return []


def iface_bytes(dev):
    base = f"/sys/class/net/{dev}/statistics/"
    try:
        with open(base + "tx_bytes") as t, open(base + "rx_bytes") as r:
            return int(t.read()), int(r.read())
    except OSError:
        return None


def gpu_stats():
    if not have("nvidia-smi"):
        return None
    rc, out = run(["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,memory.used,"
                   "memory.total,utilization.encoder", "--format=csv,noheader,nounits"])
    if rc != 0:
        return None
    try:
        u, t, mu, mt, enc = [x.strip() for x in out.splitlines()[0].split(",")]
        return dict(util=u, temp=t, mem=f"{int(mu)/1024:.1f}/{int(mt)/1024:.0f} GB", enc=enc)
    except Exception:  # noqa: BLE001
        return None


def pa_names(kind):
    """Names of PipeWire/PulseAudio sinks or sources (monitors excluded)."""
    rc, out = run(["pactl", "list", kind, "short"])
    names = [l.split("\t")[1] for l in out.splitlines() if "\t" in l] if rc == 0 else []
    return [n for n in names if not n.endswith(".monitor")]


def pa_default(kind):
    return run(["pactl", "get-default-" + kind])[1]


def route_audio(sink, source):
    """Make sink/source the defaults and move every playing/recording stream onto them."""
    moved = 0
    if sink:
        run(["pactl", "set-default-sink", sink])
        for l in run(["pactl", "list", "sink-inputs", "short"])[1].splitlines():
            moved += run(["pactl", "move-sink-input", l.split("\t")[0], sink])[0] == 0
    if source:
        run(["pactl", "set-default-source", source])
        for l in run(["pactl", "list", "source-outputs", "short"])[1].splitlines():
            moved += run(["pactl", "move-source-output", l.split("\t")[0], source])[0] == 0
    return moved


class WiVRn:
    """Thin D-Bus client for the WiVRn server."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def running(self):
        try:
            r = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                   "org.freedesktop.DBus", "NameHasOwner",
                                   GLib.Variant("(s)", (BUS_NAME,)), None,
                                   Gio.DBusCallFlags.NONE, 1000, None)
            return r.unpack()[0]
        except GLib.Error:
            return False

    def props(self):
        try:
            r = self.bus.call_sync(BUS_NAME, OBJ_PATH, "org.freedesktop.DBus.Properties",
                                   "GetAll", GLib.Variant("(s)", (IFACE,)), None,
                                   Gio.DBusCallFlags.NONE, 1000, None)
            return r.unpack()[0]
        except GLib.Error:
            return None

    def call(self, method, args=None, sig=None):
        r = self.bus.call_sync(BUS_NAME, OBJ_PATH, IFACE, method,
                               GLib.Variant(sig, args) if sig else None, None,
                               Gio.DBusCallFlags.NONE, 3000, None)
        return r.unpack() if r else None

    @staticmethod
    def start():
        subprocess.Popen(["flatpak", "run", "--command=wivrn-server", WIVRN_APP],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


# ---------------------------------------------------------------- UI helpers
def label(text="", css=None, xalign=0.0, wrap=False, select=False):
    lb = Gtk.Label(label=text, xalign=xalign)
    if css:
        for c in css.split():
            lb.get_style_context().add_class(c)
    if wrap:
        lb.set_line_wrap(True)
        lb.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    lb.set_selectable(select)
    return lb


def card(title):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.get_style_context().add_class("card")
    box.pack_start(label(title, "card-title"), False, False, 0)
    return box


def set_state(lb, text, kind):
    ctx = lb.get_style_context()
    for c in ("ok", "warn", "off", "bad", "info"):
        ctx.remove_class("state-" + c)
    ctx.add_class("state-" + kind)
    lb.set_text(text)


def copy_text(widget, text):
    Gtk.Clipboard.get_default(widget.get_display()).set_text(text, -1)


class StatGrid(Gtk.Grid):
    def __init__(self, keys):
        super().__init__(column_spacing=16, row_spacing=4)
        self.vals = {}
        for i, k in enumerate(keys):
            self.attach(label(k, "dim"), 0, i, 1, 1)
